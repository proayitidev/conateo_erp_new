enum PresenceStatus {
  PRESENT
  ABSENT
  LATE
  EARLY_LEAVE
  ON_LEAVE
}

model EmployeePresence {
  id           Int            @id @default(autoincrement())
  employeeId   Int
  presenceDate DateTime
  checkInTime  DateTime?      @db.Time()
  checkOutTime DateTime?      @db.Time()
  statusReason String?        @db.VarChar(255)
  status       PresenceStatus @default(PRESENT)

  employee Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, presenceDate], name: "presenceId")
}
