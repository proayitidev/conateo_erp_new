enum ApplicationStatus {
  PENDING
  CANCELED
  CLOSED
  MISSING_DOCUMENTS
  PENDING_CERTIFICATE
  PENDING_INVOICE
  PENDING_APPROVAL_FORM
  PENDING_PAYMENT
  INVOICE_PAID
}

enum FactureSTatus {
  PENDING
  PAID
}

enum DocumentType {
  TECHNICAL_SPECS
  TEST_REPORTS
  FCC_CE_CERTIFICATE
  AUTHORIZATION_LETTER
  PHOTO_EQUIPMENT
}

model Company {
  id      String @id @default(uuid())
  name    String
  country String
  city    String
  address String

  contactName  String
  contactEmail String
  contactPhone String?

  asApplicant      HomologationApplication[] @relation("Applicant")
  asRepresentative HomologationApplication[] @relation("Representative")
}

model Equipment {
  id    String @id @default(uuid())
  type  String
  brand String
  model String @unique

  frequencies String
  power       String
  modulations String

  applications HomologationApplication[]
}

model HomologationApplication {
  id     String            @id
  status ApplicationStatus @default(PENDING)

  manufacturerId String
  manufacturer   Company @relation("Applicant", fields: [manufacturerId], references: [id])

  representativeId String?
  representative   Company? @relation("Representative", fields: [representativeId], references: [id])

  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id])

  documents Document[]

  signatureName String?
  signatureDate DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  facture       Facture?  @relation(fields: [factureId], references: [id])
  factureId     Int?      @unique
}

model Document {
  id         String       @id @default(uuid())
  type       DocumentType
  fileUrl    String
  uploadDate DateTime     @default(now())

  applicationId       String
  application         HomologationApplication @relation(fields: [applicationId], references: [id])
  radioApplication    RadioApplication?       @relation(fields: [radioApplicationId], references: [id])
  radioApplicationId  String?
  stationInspection   StationInspection?      @relation(fields: [stationInspectionId], references: [id])
  stationInspectionId String?
}
